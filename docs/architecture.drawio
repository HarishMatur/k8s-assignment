        </mxCell>
        <mxCell id="constraints" value="Operational notes&#xa;- cloud-init or remote-exec selects the bootstrap path.&#xa;- Add-ons and the application are installed separately.&#xa;- Node disks are encrypted; IMDSv2 is required.&#xa;- Keep the S3 backend outside cluster teardown." style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=13;fontColor=#222222;spacing=10;" vertex="1" parent="1">
